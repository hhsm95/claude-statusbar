{
  "name": "@hhsm95/claude-statusbar",
  "version": "0.1.1",
  "description": "A cross-platform status line for Claude Code: model, effort, git, quota windows and context.",
  "license": "MIT",
  "author": "Hugo Sandoval",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhsm95/claude-statusbar.git"
  },
  "homepage": "https://github.com/hhsm95/claude-statusbar#readme",
  "bugs": {
    "url": "https://github.com/hhsm95/claude-statusbar/issues"
  },
  "type": "module",
  "bin": {
    "claude-statusbar": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude",
    "claude-code",
    "statusline",
    "status-bar",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.1"
  }
}
